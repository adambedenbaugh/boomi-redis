    <field id="hosts" label="Hosts" type="string">
        <helpText>For Redis Standalone, please provide the host and port separate with a semi-colon. For Redis Clustered, please provide the list of the hosts with a comma to separate them. For instance: host1:port1,host2:port2</helpText>
        <defaultValue>localhost:6379</defaultValue>
    </field>

    <field id="useSSL" label="Use SSL" type="boolean">
        <helpText>Default non-SSL port is 6379. Default SSL port is 6380.</helpText>
        <defaultValue>false</defaultValue>
    </field>
    
    <field id="authenticationType" label="Authentication Type" type="string" displayType="list">
        <helpText>Provide the authentication type. Select Microsoft Entra Client Secret Credential for Azuru Cache for Redis.</helpText>
        <defaultValue>None</defaultValue>
        <allowedValue label="None">
            <value>None</value>
        </allowedValue>
        <allowedValue label="Basic">
            <value>Basic</value>
        </allowedValue>
        <allowedValue label="Microsoft Entra Client Secret Credential">
            <value>MicrosoftEntraClientSecretCredential</value>
        </allowedValue>
    </field>

    <field id="user" label="User" type="string">
        <helpText>User Name</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>Basic</value>
            </valueCondition>
        </visibilityCondition>
    </field>
    
    <field id="password" label="Password" type="password">
        <helpText>For Redis, you can provide a password (Access Key for Azure Redis Caches)</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>Basic</value>
            </valueCondition>
        </visibilityCondition>        
    </field>

    <field id="clientId" label="Client ID" type="string">
        <helpText>Microsoft Entra Client ID</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>MicrosoftEntraClientSecretCredential</value>
            </valueCondition>
        </visibilityCondition>
    </field>
    
    <field id="clientSecret" label="Client Secret" type="password">
        <helpText>Microsoft Entra Client Secret</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>MicrosoftEntraClientSecretCredential</value>
            </valueCondition>
        </visibilityCondition>
    </field>

    <field id="tenantId" label="Tenant ID" type="string">
        <helpText>Microsoft Entra Tenant ID</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>MicrosoftEntraClientSecretCredential</value>
            </valueCondition>
        </visibilityCondition>
    </field>

    <field id="connectionTimeout" label="Connection Timeout (seconds)" type="integer">
        <helpText>Maximum time to wait for connection establishment. For Azure Redis with SSL/Auth, recommended minimum is 30 seconds.</helpText>
        <defaultValue>30</defaultValue>
    </field>

    <field id="socketTimeout" label="Socket Read Timeout (seconds)" type="integer">
        <helpText>Maximum time to wait for read operations. For Azure Redis with SSL/Auth, recommended minimum is 30 seconds.</helpText>
        <defaultValue>30</defaultValue>
    </field>

    <field id="poolEnabled" label="Enable Connection Pooling" type="boolean">
        <helpText>Select to enable connection pooling and make other fields active. Connection pooling may increase performance by using resources more efficiently. Connection pools are per JVM.</helpText>
        <defaultValue>false</defaultValue>
    </field>

    <field id="poolSize" label="Maximum Connections" type="integer">
        <helpText>Maximum pool size.</helpText>
        <defaultValue>4</defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="poolEnabled">
                <value>true</value>
            </valueCondition>
        </visibilityCondition>
    </field>
    <field id="minPoolSize" label="Minimum Connections" type="integer">
        <helpText>Minimum pool size.</helpText>
        <defaultValue>1</defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="poolEnabled">
                <value>true</value>
            </valueCondition>
        </visibilityCondition>
    </field>
    <field id="maxIdleTime" label="Maximum Idle Time" type="integer">
        <helpText>Maximum idle time in seconds for connections in the pool.</helpText>
        <defaultValue>60</defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="poolEnabled">
                <value>true</value>
            </valueCondition>
        </visibilityCondition>
    </field>
    <field id="maxWaitTime" label="Maximum Wait Time" type="integer">
        <helpText>Maximum wait time in seconds for a connection from the pool.</helpText>
        <defaultValue>60</defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="poolEnabled">
                <value>true</value>
            </valueCondition>
        </visibilityCondition>
    </field>
	
	<operation types="GET" supportsBrowse="true">
		<field id="key_prefix" label="Key Prefix" type="string">
	        <helpText>Prefix added to all key values. Include a colon (:) at the end.</helpText>
	        <defaultValue></defaultValue>
	    </field>
        <field id="remove_key_prefix_from_response" label="Remove Key Prefix from Response" type="boolean">
	        <helpText>Select to remove the key prefix from the response key(s).</helpText>
	        <defaultValue>true</defaultValue>
	    </field>
        <!-- <field id="return_only_value" label="Return Only Value in Response" type="boolean">
            <helpText>Do not return JSON response. Return only the value from the response. Not applicable for wildcard requests.</helpText>
            <defaultValue>false</defaultValue>
        </field> -->
		<!-- <field id="auto_key" label="Automatic Key Computation" type="boolean">
            <helpText>Enable Automatic Key Computation (for RESTFul APIs), please uncheck for non-API Processes</helpText>
            <defaultValue>false</defaultValue>
        </field> -->
        <field id="throw_exception" label="Throw Exception when not found" type="boolean">
            <helpText>Throw Exception when no result if found in the Cache. You will have to Catch the Exception and query the Backend System</helpText>
            <defaultValue>false</defaultValue>
        </field>
        <!-- <field id="set_ttl" label="Set Time To Live (TTL)" type="integer">
            <helpText>Set the time to live (TTL) to some number of milliseconds for every record returned. Set this to -1 to disable a change to TTL. (Redis only)</helpText>
            <defaultValue>-1</defaultValue>
        </field> -->
	</operation>
	
	<operation types="UPSERT" supportsBrowse="true">
		<field id="key_prefix" label="Key Prefix" type="string">
	        <helpText>Prefix added to all key values.</helpText>
	        <defaultValue></defaultValue>
	    </field>
		<!-- <field id="auto_key" label="Automatic Key Computation" type="boolean">
            <helpText>Enable Automatic Key Computation (for RESTFul APIs), please uncheck for non-API Processes</helpText>
            <defaultValue>false</defaultValue>
        </field> -->
        <field id="set_ttl" label="Set Time To Live (TTL)" type="integer" overrideable="true">
            <helpText>Set the time to live (TTL) in milliseconds. Set to -1 to disable a change to TTL.</helpText>
            <defaultValue>-1</defaultValue>
        </field>
	</operation>
	
	<operation types="DELETE" supportsBrowse="true">
		<field id="key_prefix" label="Key Prefix" type="string">
	        <helpText>Prefix added to all key values.</helpText>
	        <defaultValue></defaultValue>
	    </field>
		<!-- <field id="auto_key" label="Automatic Key Computation" type="boolean">
            <helpText>Enable Automatic Key Computation (for RESTFul APIs), please uncheck for non-API Processes</helpText>
            <defaultValue>false</defaultValue>
        </field> -->
	</operation>

    <!-- TODO: Add TTL document property -->
    <!-- <dynamicProperty type="string" id="ttl" label="Time To Live (TTL)" /> -->

</GenericConnectorDescriptor>
