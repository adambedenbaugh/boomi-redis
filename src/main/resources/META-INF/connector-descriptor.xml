    <field id="hosts" label="Hosts" type="string">
        <helpText>For Redis Standalone, please provide the host and port separate with a semi-colon. For Redis Clustered, please provide the list of the hosts with a comma to separate them. For instance: host1:port1,host2:port2</helpText>
        <defaultValue>localhost:6379</defaultValue>
    </field>
    
     <field id="useSSL" label="Use SSL" type="boolean">
        <helpText>Enable this option to use SSL with Azure Cachse for Redis. Default SSL Port is 6380.</helpText>
        <defaultValue>false</defaultValue>
    </field>
    
    <field id="authenticationType" label="Authentication Type" type="string" displayType="list">
        <helpText>For Redis, you can provide the authentication type. If using Azure Redis Cache, please select Microsoft Entra Client Secret Credential</helpText>
        <defaultValue>None</defaultValue>
        <allowedValue label="None">
            <value>None</value>
        </allowedValue>
        <allowedValue label="Basic">
            <value>Basic</value>
        </allowedValue>
        <allowedValue label="Microsoft Entra Client Secret Credential">
            <value>MicrosoftEntraClientSecretCredential</value>
        </allowedValue>
    </field>

    <field id="user" label="User" type="string">
        <helpText>User Name</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>Basic</value>
            </valueCondition>
        </visibilityCondition>
    </field>
    
    <field id="password" label="Password" type="password">
        <helpText>For Redis, you can provide a password (Access Key for Azure Redis Caches)</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>Basic</value>
            </valueCondition>
        </visibilityCondition>        
    </field>

    <field id="clientId" label="Client ID" type="string">
        <helpText>Microsoft Entra Client ID</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>MicrosoftEntraClientSecretCredential</value>
            </valueCondition>
        </visibilityCondition>
    </field>
    
    <field id="clientSecret" label="Client Secret" type="password">
        <helpText>Microsoft Entra Client Secret</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>MicrosoftEntraClientSecretCredential</value>
            </valueCondition>
        </visibilityCondition>
    </field>

    <field id="tenantId" label="Tenant ID" type="string">
        <helpText>Microsoft Entra Tenant ID</helpText>
        <defaultValue></defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="authenticationType">
                <value>MicrosoftEntraClientSecretCredential</value>
            </valueCondition>
        </visibilityCondition>
    </field>

    <!-- <field id="properties_filter" label="Dynamics Process Properties Filter" type="string">
        <helpText>For the Automatic Key Computation (for RESTFul APIs), you can set the regular expression to filter HTTP queries and HTTP parameters</helpText>
        <defaultValue>(query_.*)|(param_.*)</defaultValue>
    </field> -->
    
    <!-- <field id="hashing" label="Apply SHA Hashing during Automatic Key Computation" type="boolean">
        <helpText>Apply SHA Hashing during Automatic Key Computation</helpText>
        <defaultValue>false</defaultValue>
    </field> -->

    <field id="poolEnabled" label="Enable Connection Pooling" type="boolean">
        <helpText>If using Redis, enable connection pooling</helpText>
        <defaultValue>true</defaultValue>
    </field>

    <field id="poolSize" label="Size of the connection pool" type="integer">
        <helpText>If using Redis, pool size</helpText>
        <defaultValue>8</defaultValue>
        <visibilityCondition>
            <valueCondition fieldId="poolEnabled">
                <value>true</value>
            </valueCondition>
        </visibilityCondition>
    </field>
	
	<operation types="GET" supportsBrowse="true">
		<field id="cache_name" label="Key Prefix" type="string">
	        <helpText>Prefix added to all key values.</helpText>
	        <defaultValue></defaultValue>
	    </field>
		<field id="auto_key" label="Automatic Key Computation" type="boolean">
            <helpText>Enable Automatic Key Computation (for RESTFul APIs), please uncheck for non-API Processes</helpText>
            <defaultValue>false</defaultValue>
        </field>
        <field id="wrap_inprofile" label="Return XML Response" type="boolean">
            <helpText>Wrap ID and Value element from Cache in a XML object</helpText>
            <defaultValue>true</defaultValue>
        </field>
        <field id="throw_exception" label="Throw Exception when not found" type="boolean">
            <helpText>Throw Exception when no result if found in the Cache. You will have to Catch the Exception and query the Backend System</helpText>
            <defaultValue>false</defaultValue>
        </field>
        <field id="set_ttl" label="Set Time To Live (TTL)" type="integer">
            <helpText>Set the time to live (TTL) to some number of milliseconds for every record returned. Set this to -1 to disable a change to TTL. (Redis only)</helpText>
            <defaultValue>-1</defaultValue>
        </field>
	</operation>
	
	<operation types="UPSERT" supportsBrowse="true">
		<field id="cache_name" label="Key Prefix" type="string">
	        <helpText>Prefix added to all key values.</helpText>
	        <defaultValue></defaultValue>
	    </field>
		<field id="auto_key" label="Automatic Key Computation" type="boolean">
            <helpText>Enable Automatic Key Computation (for RESTFul APIs), please uncheck for non-API Processes</helpText>
            <defaultValue>false</defaultValue>
        </field>
        <field id="set_ttl" label="Set Time To Live (TTL)" type="integer">
            <helpText>Set the time to live (TTL) to some number of milliseconds for every record returned. Set this to -1 to disable a change to TTL. (Redis and Memcached)</helpText>
            <defaultValue>-1</defaultValue>
        </field>
	</operation>
	
	<operation types="DELETE" supportsBrowse="true">
		<field id="cache_name" label="Key Prefix" type="string">
	        <helpText>Prefix added to all key values.</helpText>
	        <defaultValue></defaultValue>
	    </field>
		<field id="auto_key" label="Automatic Key Computation" type="boolean">
            <helpText>Enable Automatic Key Computation (for RESTFul APIs), please uncheck for non-API Processes</helpText>
            <defaultValue>false</defaultValue>
        </field>
	</operation>

    <!-- TODO: Add TTL document property -->
    <!-- <dynamicProperty type="string" id="ttl" label="Time To Live (TTL)" /> -->

</GenericConnectorDescriptor>
